     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5 4 3 2 1 "
     ]
    }
   ],
   "source": [
    "# print 1-5\n",
    "\n",
    "def print_numbers(L,R):\n",
    "    # base case\n",
    "    if L > R:\n",
    "        return\n",
    "    print_numbers(L+1, R)\n",
    "    print(L, end=\" \")\n",
    "    \n",
    "print_numbers(1, 5)"
   ]
  },
